# ============================================================
#  《重返未来：1999》剧情 RAG  —  环境变量模板
#  用法: copy .env.example .env  然后填 [必填] 项
#  ⚠️ 本项目只用【云端模型】, 不需要本地 Ollama
#  ⚠️ EMBEDDING 相关项在第一次灌数据后【不能改】, 会需要重建索引
# ============================================================

# ------------------------------------------------------------
# 【必填 1】LLM  ——  OpenAI 兼容接口
# ------------------------------------------------------------
# 下面给三套常用预设, 选一套取消注释即可。
# 中文剧情理解 + 实体抽取, 推荐 qwen-plus 档次起步。

# --- 预设 A: 阿里云百炼 / DashScope (Qwen 官方) ---
LLM_BINDING=openai
LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BINDING_API_KEY=sk-REPLACE_ME
LLM_MODEL=qwen-plus
EXTRACT_LLM_MODEL=qwen-plus
KEYWORD_LLM_MODEL=qwen-turbo
QUERY_LLM_MODEL=qwen-max

# --- 预设 B: DeepSeek 官方 ---
# LLM_BINDING=openai
# LLM_BINDING_HOST=https://api.deepseek.com/v1
# LLM_BINDING_API_KEY=sk-REPLACE_ME
# LLM_MODEL=deepseek-chat
# EXTRACT_LLM_MODEL=deepseek-chat
# KEYWORD_LLM_MODEL=deepseek-chat
# QUERY_LLM_MODEL=deepseek-chat

# --- 预设 C: 任意 OpenAI 兼容中转 ---
# LLM_BINDING=openai
# LLM_BINDING_HOST=https://your-relay.example.com/v1
# LLM_BINDING_API_KEY=sk-REPLACE_ME
# LLM_MODEL=gpt-4o-mini
# EXTRACT_LLM_MODEL=gpt-4o-mini
# KEYWORD_LLM_MODEL=gpt-4o-mini
# QUERY_LLM_MODEL=gpt-4o

TIMEOUT=180
MAX_ASYNC_LLM=4              # 云端有 QPS 限制, 别调太高
MAX_PARALLEL_INSERT=3

# --- 按角色关闭推理 (仅推理型模型需要, 如 DeepSeek) ----------------------
# 实体/关系抽取是结构化 JSON 任务, 不需要思考链。实测关掉后:
#   输出 token 297 -> 25 (降到 1/12), 单次耗时 2.28s -> 1.01s (0.44x)
# 写法: {角色}_{BINDING}_{字段}; extra_body 是 JSON dict。
# 角色: EXTRACT(抽取) / KEYWORD(关键词) / QUERY(回答) / VLM
# 验证链路可用: scripts/_probe_extra_body.py
# 注意: 只有 OpenAI binding 有 extra_body 字段(Bedrock 是 extra_fields,
#       Ollama 是 think 开关), 换服务商时要相应改写。
EXTRACT_OPENAI_LLM_EXTRA_BODY='{"thinking": {"type": "disabled"}}'
KEYWORD_OPENAI_LLM_EXTRA_BODY='{"thinking": {"type": "disabled"}}'
# 回答角色默认保留思考以保证质量:
# QUERY_OPENAI_LLM_EXTRA_BODY='{"thinking": {"type": "disabled"}}'

# ------------------------------------------------------------
# 【必填 2】Embedding  ——  ⚠️ 灌数据后不可更改
# ------------------------------------------------------------
# 用户指定: 用 qwen 小模型做向量。
# text-embedding-v4 支持自定义维度; 选 1024 平衡质量与存储。
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BINDING_API_KEY=sk-REPLACE_ME
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_TOKEN_LIMIT=8192
EMBEDDING_SEND_DIM=true       # DashScope 需显式传 dimensions 参数
EMBEDDING_USE_BASE64=false    # DashScope 不支持 base64 编码的 embedding
EMBEDDING_FUNC_MAX_ASYNC=4
EMBEDDING_BATCH_NUM=10      # 百炼 OpenAI 兼容接口单次上限是 10, 超过报 400
EMBEDDING_TIMEOUT=60

# ------------------------------------------------------------
# 【必填 3】服务器
# ------------------------------------------------------------
HOST=0.0.0.0                  # 容器内必须 0.0.0.0; 对外端口由 compose 绑定到 127.0.0.1
PORT=9621
WORKERS=2
WEBUI_TITLE='1999 剧情档案'
WEBUI_DESCRIPTION='《重返未来：1999》简体中文剧情检索'
ENABLE_AI_CONTENT_NOTICE=true

# 鉴权: 本机自用可留空; 一旦要让别人访问就必须填
LIGHTRAG_API_KEY=
# AUTH_ACCOUNTS='admin:{bcrypt}$2b$12$...'
# TOKEN_SECRET=REPLACE_ME

# ------------------------------------------------------------
# 【必填 4】文档处理  —— 简体中文
# ------------------------------------------------------------
SUMMARY_LANGUAGE=Chinese
ENTITY_EXTRACTION_USE_JSON=true
# .md 走 native 引擎(产出标题层级 sidecar) + P 段落语义分块; 其余格式回退
LIGHTRAG_PARSER=md:native-P,*:legacy-R
CHUNK_P_SIZE=2000
CHUNK_P_OVERLAP_SIZE=100
ENABLE_CONTENT_HEADINGS=true   # 回答上下文带章节路径, 提升引用可读性
VLM_PROCESS_ENABLE=false       # 纯文本语料, 不需要视觉模型

# 实体类型引导 (放 data/prompts/entity_type/entity_type_prompt.yml)
ENTITY_TYPE_PROMPT_FILE=entity_type_prompt.yml

# ------------------------------------------------------------
# Rerank —— 查询期能力, 随时可开关, 不影响索引
# 本项目实测配置: 开启百炼 gte-rerank-v2 (对中文剧情检索提升明显)
# 注意 RERANK_BINDING_API_KEY 用【百炼】的 Key, 不是 LLM 那把
# ------------------------------------------------------------
RERANK_BINDING=aliyun
RERANK_MODEL=gte-rerank-v2
RERANK_BINDING_HOST=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_BINDING_API_KEY=sk-REPLACE_ME
RERANK_BY_DEFAULT=True
MAX_ASYNC_RERANK=4
RERANK_TIMEOUT=30

# 想关掉重排 (省调用、降延迟) 就把上面 4 行 RERANK_* 换成:
# RERANK_BINDING=null

# ------------------------------------------------------------
# 【可选】检索预算
# ------------------------------------------------------------
TOP_K=40
CHUNK_TOP_K=20
MAX_ENTITY_TOKENS=6000
MAX_RELATION_TOKENS=8000
MAX_TOTAL_TOKENS=30000
KG_CHUNK_PICK_METHOD=VECTOR
RELATED_CHUNK_NUMBER=5

# ------------------------------------------------------------
# 存储后端  ——  ⚠️ 加了文档之后不能改
# ------------------------------------------------------------
# PostgreSQL 四件套: 一个 PG 实例承担 KV / 向量 / 图谱 / 文档状态。
#
# 为什么不用文件型 (JsonKVStorage / NanoVectorDBStorage / NetworkXStorage):
#   * 上游 AGENTS.md 明确写着这五个文件型存储
#     "are supported for small-scale testing and validation only"
#   * NetworkXStorage 每次图编辑都要重写整份 GraphML
#   * 云端抽取要花钱, 存储选错后再改 = 重新索引一遍
#
# 备选(仅当不想起 PG 容器时): 文件型
#   LIGHTRAG_KV_STORAGE=JsonKVStorage
#   LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
#   LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
#   LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGTableGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

# 连接参数填【宿主机视角】(localhost:5433)。
# docker-compose.yml 会把容器内的值覆盖为 postgres:5432。
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=lightrag
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DATABASE=rag
POSTGRES_VECTOR_INDEX_TYPE=HNSW
POSTGRES_HNSW_M=16
POSTGRES_HNSW_EF=200

# ------------------------------------------------------------
# 目录 (compose 会覆盖为容器内路径)
# ------------------------------------------------------------
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs
PROMPT_DIR=/app/data/prompts
UI_TEMPLATES_DIR=/app/data/ui_templates

# ------------------------------------------------------------
# 日志
# ------------------------------------------------------------
LOG_LEVEL=INFO
