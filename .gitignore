# ------------------------------------------------------------
# 密钥与本地配置（只提交 .env.example）
# ------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------
# 运行时数据（体积大、不可 diff，用 DB 备份而非 git）
# ------------------------------------------------------------
data/inputs/
data/cleaned/
data/rag_storage/
data/backups/
data/prompts/*.local.yml
data/ui_templates/*

# PostgreSQL 数据目录 —— ≈970 MB 二进制页文件，绝不入库
# （备份请用 pg_dump，见 README「备份与恢复」）
data/pgdata/
pgdata/

# LightRAG 文件型存储（若切回默认后端会在此生成）
rag_storage/

# ------------------------------------------------------------
# 语料（第三方版权内容，独立 clone，用 corpus.lock.json 锁版本）
# ------------------------------------------------------------
corpus/

# ------------------------------------------------------------
# 视觉参考素材（第三方版权）——本地比对用，绝不入库、绝不随仓库分发
# 含 wiki 首页截图、官方美术资源等。风格 token 已提取成 web/src/styles/tokens.css，
# 参考图本身不需要进版本历史。
# ------------------------------------------------------------
docs/ref/

# ------------------------------------------------------------
# 前端（web/）第三方内容与构建产物
#   public/bg/    整站背景图（官方美术，仅本地自用；上线换自制素材）
#   public/data/quotes.json  由语料抽出的「今日台词」（第三方文本）
#   dist/ node_modules/      构建产物与依赖
# ------------------------------------------------------------
web/public/bg/
web/public/data/quotes.json
web/node_modules/
web/dist/

# ------------------------------------------------------------
# 上游 LightRAG 源码（保持可 git pull，不纳入本项目历史）
# ------------------------------------------------------------
LightRAG/

# ------------------------------------------------------------
# state/ 下的索引清单必须进 git —— 它是「本次索引对应哪个语料
# 版本、哪套配置」的可追溯凭据。此处显式反忽略以防将来误加规则。
# 下划线开头的是临时计划文件（如 reindex.py --from-plan 的输入），不入库。
# ------------------------------------------------------------
state/_*
!state/index_manifest.json
!state/corpus.lock.json
!state/chapter_index.json

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ------------------------------------------------------------
# 编辑器 / 系统
# ------------------------------------------------------------
.vscode/
.idea/
.DS_Store
*.log
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# 打包 / 构建产物
# ------------------------------------------------------------
*.tgz
*.tar.gz
*.zip
dist/
build/

# ------------------------------------------------------------
# 本地工作文档（AI 协作笔记与推导过程）——不入库、不随仓库分发。
# 公开仓库只保留能跑起来的代码与运行说明（三份 README）。
# 这些文件仍在工作区里，只是不进版本历史。
# 路径一律用 `/` 开头锚定仓库根，避免误伤 server/README.md 之类同名文件。
# ------------------------------------------------------------
/AGENTS.md
/next.md
/website.md
/流程与架构.md
/docs/检索调参.md
/docs/RAG选型报告.md
/docs/开发手册01-入门实操.md
/docs/开发手册02-速查参考.md
/docs/开发手册03-设计约束.md
/web/design/README.md